# Copy this file to ".env" (same folder as server.py) and fill in what you need.
# Everything is optional - without keys you still get LSM news with the browser's own voice.

# Secret part of the link the phone uses. If empty, one is generated and kept in .access_key.
# On a hosted server ALWAYS set it here, otherwise it changes on every restart.
# ACCESS_KEY=choose-a-long-random-word

# Newspaper photo ("Lasīt avīzi"): an Anthropic API key from https://platform.claude.com
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5-5        # or claude-haiku-5-5: about 20x cheaper, test the quality
# PHOTO_DAILY_LIMIT=80                  # max Claude requests per day (1 per page + 1 per article read)

# Natural Latvian voices served to phones that have none (Azure AI Speech, free tier is enough)
# AZURE_SPEECH_KEY=...
# AZURE_SPEECH_REGION=westeurope
# AZURE_VOICES=lv-LV-EveritaNeural,lv-LV-NilsNeural
# TTS_DAILY_CHARS=60000

# Behaviour
# WAIT_SECONDS=6          # pause after each headline in which a tap opens the article
# LONG_PRESS_MS=1000      # hold this long = stop / back
# DEFAULT_RATE=0.9        # speech speed
# MAX_HEADLINES=12

# Network
# HOST=0.0.0.0            # 0.0.0.0 = reachable from phones in the same Wi-Fi; 127.0.0.1 = this computer only
# PORT=8765
